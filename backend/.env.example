PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Database Configuration
# Local MongoDB: mongodb://localhost:27017/skinova
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skinova?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/skinova

# Authentication Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# PayHere Sandbox Credentials
PAYHERE_MERCHANT_ID=1211149
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_SANDBOX=true
PAYHERE_NOTIFY_URL=http://localhost:5000/api/payments/payhere/notify

# Business Settings
WHATSAPP_BUSINESS_NUMBER=+94771234567
STORE_CURRENCY=LKR
FREE_DELIVERY_THRESHOLD=7500
DEFAULT_DELIVERY_FEE=450
 
# Email / SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=false
SMTP_FROM="Skinova Botanical Skincare" <noreply@skinova.lk>
